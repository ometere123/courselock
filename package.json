{
  "name": "courselock-genlayer-ic",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone GenLayer CourseLock semantic reliance primitive, StudioNet 61999 only",
  "scripts": {
    "cli:version": "genlayer --version",
    "network:select": "genlayer network set studionet",
    "network:info": "genlayer network info",
    "network:guard": "node scripts/assert_studionet.mjs",
    "deploy:guarded": "node scripts/deploy_studionet.mjs",
    "test:offline": "python -m pytest tests -q",
    "preflight": "python scripts/preflight.py"
  },
  "devDependencies": {
    "genlayer": "0.39.1",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "genlayer": {
      "vitest": "4.1.11"
    }
  }
}
